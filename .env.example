# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Square Web Payments SDK — used by the checkout card form in the browser.
# VITE_SQUARE_ENV controls which SDK script loads: "sandbox" or "production".
# Leave on "sandbox" until you're ready to take real payments.
VITE_SQUARE_ENV=sandbox
VITE_SQUARE_APP_ID=

# --- Supabase Edge Function secrets (set these in the Supabase dashboard —
# Project Settings → Edge Functions → Secrets — NOT in this file) ---
# SQUARE_ACCESS_TOKEN   Server-side Square access token, sandbox or production
# SQUARE_ENV            "sandbox" or "production" — must match VITE_SQUARE_ENV
#                        and match the environment your SQUARE_ACCESS_TOKEN belongs to
